{
  "pluginId": "whisper",
  "repo": "whisper-obsidian-plugin",
  "bindings": [
    {
      "cursorEnv": "GEMINI_API_KEY",
      "secretStorageId": "gemini-api-key",
      "read": "SettingsManager.loadKeysFromSecretStorage → settings.geminiApiKey; GeminiTranscriber and GeminiLiveTranscriber",
      "pointer": null
    },
    {
      "cursorEnv": "OPENAI_API_KEY",
      "secretStorageId": "openai-api-key",
      "read": "settings.openAiApiKey (SECRET_IDS) and settings.apiKey when whisperApiKeySecretId points here",
      "pointer": {
        "pluginId": "whisper",
        "path": ["whisperApiKeySecretId"]
      }
    }
  ]
}
